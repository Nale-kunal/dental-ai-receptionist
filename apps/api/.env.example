# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL pooled connection (for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon direct connection (for migrations only)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_BYTE_HEX_STRING"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="debug"

# ─── Email (optional) ─────────────────────────────────────────────────────────
# Leave blank to disable email. App will show "Email not configured" status.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ─── Integration Credential Security (AES-256-GCM) ───────────────────────────
# 32-byte (64-character hex) key for encrypting provider credentials at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Never commit to git or expose to frontend.
INTEGRATION_ENCRYPTION_KEY="REPLACE_WITH_64_CHARACTER_HEX_STRING"

# ─── WhatsApp / Meta (optional, server-side only — NEVER expose to frontend) ──
# Leave blank to disable WhatsApp integration
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WABA_ID=""
META_WEBHOOK_VERIFY_TOKEN=""

# ─── Application URL ──────────────────────────────────────────────────────────
APP_URL="http://localhost:5173"
